# ==========================================================
# Telegram API Credentials (Required)
# Obtain yours from https://my.telegram.org under "API development tools"
# ==========================================================
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH

# ==========================================================
# Command Handler Prefix
# The symbol or string that triggers userbot commands (e.g. .saveit, !saveit)
# ==========================================================
HANDLER=.saveit

# ==========================================================
# Timed Media Auto-Saver
# Automatically downloads and saves incoming disappearing/self-destructing media
# Values: true | false
# ==========================================================
AUTO_SAVE_TIMED=true

# ==========================================================
# Group & Channel Tutorial Forwarder
# Comma-separated list of group/channel IDs or usernames to auto-forward from.
# Supports numeric IDs (e.g. -1001234567890) and usernames (e.g. @python_tutorials)
# (Tip: Run 'python3 Saveit.py --list-chats' or type '.id' in the group to get chat IDs)
# ==========================================================
FORWARD_GROUP_IDS=

# ==========================================================
# Filter: Media Only
# If true, only forwards messages containing media (videos, documents, photos, audio).
# If false, forwards all tutorial content including code snippets and explanations.
# Values: true | false (Default: false)
# ==========================================================
FORWARD_MEDIA_ONLY=false

# ==========================================================
# Forwarding Mode
# 'forward' - Uses native Telegram forwarding. Fast, zero disk overhead, preserves credits.
#             If group has content protection ('noforwards'), automatically falls back to
#             direct download and re-upload.
# 'copy'    - Always downloads media and re-uploads as original files without forward tags.
# Values: forward | copy (Default: forward)
# ==========================================================
FORWARD_MODE=forward

# ==========================================================
# Catch-Up / Backfill Limit
# Number of recent messages to fetch and save from monitored groups upon bot startup.
# Set to 'all' to scan from message #1 at the beginning of the chat history.
# Set to 0 to only capture new incoming messages from now on.
# Default: 0
# ==========================================================
BACKFILL_LIMIT=0

# ==========================================================
# Original Quality (No Compression)
# Sends media files as documents to preserve 100% original quality and formatting.
# Values: true | false (Default: true)
# ==========================================================
FORCE_DOCUMENT=true

# ==========================================================
# Cleanup Local Downloads
# Delete downloaded media files from the 'downloads/' folder after uploading to Saved Messages.
# Values: true | false (Default: false)
# ==========================================================
CLEANUP_DOWNLOADS=false

# ==========================================================
# SQLite Duplicate File Tracker Database
# Tracks saved messages, Telegram file IDs, and SHA-256 hashes to prevent duplicates.
# Default: saveit_tracker.db
# ==========================================================
TRACKER_DB=saveit_tracker.db

# ==========================================================
# Rate Limiting & FloodWait Protection
# Paces message forwarding, file uploads, and text sends to avoid Telegram rate limits.
# RATE_LIMIT_DELAY: Minimum seconds to wait between outgoing actions (Default: 1.5)
# FLOOD_SLEEP_THRESHOLD: Max seconds to automatically sleep on FloodWait (Default: 60)
# ==========================================================
RATE_LIMIT_DELAY=1.5
FLOOD_SLEEP_THRESHOLD=60